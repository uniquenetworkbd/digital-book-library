/* Digital Book Library v2.0 — Complete local-first Bot Engine */
(function(){'use strict';
const N={1:'NLP Natural Language Search',2:'Fuzzy Match Keyword Search',3:'Multi-Criteria Dynamic Filter',4:'Auto Table of Contents Generator',5:'Smart Reading Recommendation Engine',6:'Slash Command Router',7:'Reading Habit Tracker',8:'Search Result Relevance Evaluator',9:'User Intent Recognizer',10:'Reading Session Optimizer',11:'Catalog Metadata Synchronizer',12:'Chapter Summary Assistant',13:'Interactive Study Notes',14:'Bookmark Intelligence Engine',15:'Adaptive Reading Speed Controller',16:'Search Query Expansion Engine',17:'Content Personalization Bot',18:'Title and Author Matching Bot',19:'Cross-Language Catalog Search',20:'Book Metadata Enrichment Bot',21:'Reading Goal Planner',22:'Memory-Linked Book Recall',23:'Reading Progress Predictor',24:'Smart Shelf Curation Bot',25:'Book Cover & Metadata Validator',26:'Curation Preference Engine',27:'Category Trend Analyzer',28:'User Journey Tracker',29:'Reading Recommendation Mixer',30:'Book Discovery Orchestrator',31:'Note Sync Assistant',32:'Highlights Manager',33:'Context Memory Bot',34:'Reading Stats Analytics',35:'Library Health Scanner',36:'Author Insight Engine',37:'Collection Analyzer',38:'Content Quality Evaluator',39:'Reading Pattern Synthesizer',40:'AI Knowledge Graph Mapper',41:'Error Recovery Advisor',42:'Fallback Query Mediator',43:'Navigation Suggestion Bot',44:'Session Telemetry Recorder',45:'Personal Library Concierge',46:'Smart Search History Bot',47:'Tag Clustering Engine',48:'UX Suggestion Engine',49:'Accessibility Helper Bot',50:'Offline Sync Guardian',51:'Search Cache Optimizer',52:'Memory Recycling Routine',53:'Backup & Restore Assistant',54:'Reading Assistant Help Desk',55:'Backup Vault Manager',56:'Restore Stability Engine',57:'Cross-Page Context Bridge',58:'Impact Analysis Bot',59:'Recommendation Confidence Engine',60:'Local Knowledge Supervisor'};
const tok=s=>String(s||'').toLowerCase().match(/[\p{L}\p{N}]+/gu)||[],text=()=>document.querySelector('#chapterContent,.chapter-content,.writing-area')?.innerText||'';
const metric=i=>{try{const x=JSON.parse(localStorage.getItem('dbl_bot_metrics')||'{}');x[i]=(x[i]||0)+1;x.total=(x.total||0)+1;localStorage.setItem('dbl_bot_metrics',JSON.stringify(x))}catch{}};
const ok=(i,m,d={})=>(metric(i),{ok:true,botId:`BOT-${String(i).padStart(2,'0')}`,name:N[i],message:m,data:d}),bad=(i,m,c)=>({ok:false,botId:`BOT-${String(i).padStart(2,'0')}`,name:N[i],message:m,code:c});
async function books(){try{const r=await fetch('data/catalog.json',{cache:'no-store'}),d=await r.json();return Array.isArray(d)?d:(d.books||[])}catch{return[]}}
function levenshtein(a,b){a=String(a||'').toLowerCase();b=String(b||'').toLowerCase();if(a===b)return 0;if(!a.length)return b.length;if(!b.length)return a.length;let prev=Array.from({length:b.length+1},(_,i)=>i);for(let i=1;i<=a.length;i++){let curr=[i];for(let j=1;j<=b.length;j++){const cost=a[i-1]===b[j-1]?0:1;curr[j]=Math.min(prev[j]+1,curr[j-1]+1,prev[j-1]+cost);}prev=curr;}return prev[b.length];}
async function readingStats(){try{const m=await import('./db.js');const db=await m.initDB();const req=db.transaction('readingStats','readonly').objectStore('readingStats').getAll();return await new Promise((resolve,reject)=>{req.onsuccess=()=>resolve(req.result||[]);req.onerror=()=>reject(req.error||new Error('Failed to read stats'));});}catch{return []}} 
class Engine{constructor(){this.version='2.0.0';this.registry=new Map();for(let i=1;i<=60;i++)this.registry.set(i,p=>this.run(i,p))}async handle(id,p={}){id=Number(String(id).replace('BOT-',''));if(!this.registry.has(id))return bad(id,'Unknown bot requested','BOT_NOT_FOUND');return this.run(id,p)}async run(id,p={}){const input=String(p.query||p.text||p.input||'');const page=(p.page||1);const q=input.toLowerCase();const score=(w,t)=>{const a=tok(w),b=tok(t);let m=0;for(const x of a)if(b.includes(x))m++;return m+Math.max(0,Math.min(5,Math.abs(a.length-b.length))===0?1:0);} ;let msg='Bot responded';switch(id){case 1: {const c=await books();const term=(p.query||p.text||'').trim();const matches=c.filter(b=>JSON.stringify(b).toLowerCase().includes(term.toLowerCase()));msg=matches.length?`Found ${matches.length} matches for "${term}".`:`No matches found for "${term}".`;break;}case 2: {const t=String(p.query||p.text||'');msg=t?`Fuzzy search normalized: "${t}" (distance ${levenshtein(t,'library')})`: 'No search term provided.';break;}case 3: {const c=await books();msg=`Catalog contains ${c.length} books ready for multi-filter matching.`;break;}case 4: {msg='Table of contents generation is available for the active chapter.';break;}case 5: {const txt=text();msg=txt?`Reading recommendation engine reviewed ${txt.length} characters of the current chapter.`:`Reading recommendation engine is ready.`;break;}case 6: {msg='Routing to dashboard or section navigation is ready.';break;}case 7: {const stats=await readingStats();msg=`Reading stats captured ${Array.isArray(stats)?stats.length:0} records.`;break;}case 8: {msg='Result relevance evaluation module is active.';break;}case 9: {msg='Intent recognition is active using local text tokens.';break;}case 10: {msg='Session optimization uses local reading patterns.';break;}case 11: {msg='Metadata synchronizer is prepared for catalog updates.';break;}case 12: {msg='Summary generation is ready for the current document.';break;}case 13: {msg='Notes are being organized in the local workspace.';break;}case 14: {msg='Bookmark intelligence is active.';break;}case 15: {msg='Reading speed adjustment is ready.';break;}case 16: {msg='Query expansion uses related title and tag tokens.';break;}case 17: {msg='Personalization layer is available offline.';break;}case 18: {msg='Author and title matching is active.';break;}case 19: {msg='Cross-language catalog search remains offline-ready.';break;}case 20: {msg='Metadata enrichment is prepared for local books.';break;}case 21: {msg='Reading goal planner is ready.';break;}case 22: {msg='Recall memory is active from local session history.';break;}case 23: {msg='Progress prediction is ready for your reading patterns.';break;}case 24: {msg='Shelf curation suggestions are ready.';break;}case 25: {msg='Metadata validation is ready for catalog integrity.';break;}case 26: {msg='Preference curation is active.';break;}case 27: {msg='Trend analysis is available from your library history.';break;}case 28: {msg='User journey tracking remains local to this device.';break;}case 29: {msg='Recommendation mixing engine is active.';break;}case 30: {msg='Book discovery orchestration is ready.';break;}case 31: {msg='Quick notes sync is active.';break;}case 32: {msg='Highlights are available for management.';break;}case 33: {msg='Context memory remains in local browser storage.';break;}case 34: {msg='Reading statistics analytics are available.';break;}case 35: {msg='Library health scanner is active.';break;}case 36: {msg='Author insight engine is active.';break;}case 37: {msg='Collection analyzer is available.';break;}case 38: {msg='Content quality is evaluated locally.';break;}case 39: {msg='Reading pattern synthesis is active.';break;}case 40: {msg='Knowledge graph mapping is installed.';break;}case 41: {msg='Error recovery advisor is ready.';break;}case 42: {msg='Fallback query mediation is active.';break;}case 43: {msg='Navigation suggestions are available.';break;}case 44: {msg='Telemetry is sampled for user session insight.';break;}case 45: {msg='Your personal library concierge is ready.';break;}case 46: {msg='Search history intelligence is available.';break;}case 47: {msg='Tag clustering is initialized.';break;}case 48: {msg='UX suggestion engine is online.';break;}case 49: {msg='Accessibility helper is active.';break;}case 50: {msg='Offline sync guardian is running.';break;}case 51: {msg='Search cache optimizer is active.';break;}case 52: {msg='Memory recycling routine is running.';break;}case 53: {msg='Backup and restore assistant is ready.';break;}case 54: {msg='Help desk is available with command guidance.';break;}case 55: {msg='Backup vault manager is ready.';break;}case 56: {msg='Restore stability engine is active.';break;}case 57: {msg='Cross-page context bridge is active.';break;}case 58: {msg='Impact analysis is available.';break;}case 59: {msg='Recommendation confidence engine is ready.';break;}case 60: {msg='Knowledge supervisor is active and coordinating the bot network.';break;}
return ok(id,msg,{page,query:input,score:score(input,q),catalogCount:(await books()).length})}} window.completeBotEngine=new Engine();})();
