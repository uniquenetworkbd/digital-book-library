<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Book Library Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        background:
          radial-gradient(circle at top, rgba(59, 130, 246, 0.18), transparent 40%),
          linear-gradient(135deg, #020817 0%, #0f172a 45%, #111827 100%);
      }
      .glass {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: 0 20px 45px rgba(2, 6, 23, 0.45);
        backdrop-filter: blur(18px);
      }
      .message-scroll::-webkit-scrollbar {
        width: 10px;
      }
      .message-scroll::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.3);
        border-radius: 9999px;
      }
    </style>
  </head>
  <body class="min-h-screen text-slate-100 antialiased">
    <div class="mx-auto flex min-h-screen max-w-7xl flex-col p-4 md:p-8">
      <header class="mb-4 flex items-center justify-between rounded-2xl border border-slate-700/80 bg-slate-900/60 px-4 py-3 shadow-lg">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-sky-300">Client-Side PWA</p>
          <h1 class="text-xl font-bold text-white md:text-2xl">Digital Book Library Assistant</h1>
        </div>
        <button id="clearChatButton" class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-200 transition hover:border-sky-400 hover:text-white">
          Clear Chat
        </button>
      </header>

      <main class="glass flex min-h-[70vh] flex-1 flex-col overflow-hidden rounded-3xl">
        <div class="flex items-center justify-between border-b border-slate-700/80 px-4 py-3">
          <div>
            <p class="text-sm font-medium text-sky-300">Master Bot Engine</p>
            <p class="text-xs text-slate-400">BOT-01 to BOT-61 • Local-first runtime</p>
          </div>
          <div class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-1 text-[11px] font-medium text-emerald-300">
            Active
          </div>
        </div>

        <section id="chatMessages" class="message-scroll flex-1 space-y-4 overflow-y-auto px-4 py-5"></section>

        <form id="chatForm" class="border-t border-slate-700/80 bg-slate-900/40 p-4">
          <div class="flex flex-col gap-3 md:flex-row md:items-center">
            <input
              id="userInput"
              type="text"
              autocomplete="off"
              placeholder="Try: BOT-01 fantasy, /search fiction, /help, BOT-21 speak hello"
              class="w-full rounded-2xl border border-slate-600 bg-slate-950/70 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-500 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20"
            />
            <button
              type="submit"
              class="rounded-2xl bg-sky-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-500/30"
            >
              Send
            </button>
          </div>
        </form>
      </main>
    </div>

    <script src="assets/js/bot-engine-part1.js"></script>
    <script src="assets/js/bot-engine-part2.js"></script>
    <script src="assets/js/complete-bot-engine.js"></script>
    <script>
      (function () {
        const messagesEl = document.getElementById('chatMessages');
        const inputEl = document.getElementById('userInput');
        const formEl = document.getElementById('chatForm');
        const clearBtn = document.getElementById('clearChatButton');

        const chat = {
          add(role, text) {
            const row = document.createElement('div');
            row.className = `flex ${role === 'assistant' ? 'justify-start' : 'justify-end'}`;

            const bubble = document.createElement('div');
            bubble.className = `max-w-3xl rounded-2xl px-4 py-3 text-sm leading-7 ${
              role === 'assistant'
                ? 'border border-slate-700 bg-slate-800/90 text-slate-100'
                : 'bg-sky-500 text-white shadow-lg shadow-sky-500/20'
            }`;

            const textEl = document.createElement('div');
            textEl.textContent = text;
            bubble.appendChild(textEl);
            row.appendChild(bubble);
            messagesEl.appendChild(row);
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        };

        chat.add('assistant', 'Welcome. I am the local-first Digital Book Library assistant. Ask for catalog search, bookmarks, reading stats, TTS, export, or bot commands.');

        function renderResult(result) {
          const message = typeof result === 'string' ? result : result?.message || 'Command complete.';
          chat.add('assistant', message);
        }

        formEl.addEventListener('submit', async function (event) {
          event.preventDefault();
          const rawValue = inputEl.value.trim();
          if (!rawValue) return;

          chat.add('user', rawValue);
          inputEl.value = '';

          try {
            if (!window.MasterBotEngine) {
              throw new Error('MasterBotEngine is not available.');
            }
            const engine = window.masterBotEngine || new window.MasterBotEngine();
            const result = await engine.processCommand(rawValue, { chatTarget: chat });
            renderResult(result);
          } catch (error) {
            console.error(error);
            chat.add('assistant', error.message || 'An unexpected error occurred while processing the request.');
          }
        });

        clearBtn.addEventListener('click', () => {
          messagesEl.innerHTML = '';
          chat.add('assistant', 'Conversation cleared. Ready for the next request.');
        });
      })();
    </script>
  </body>
</html>
